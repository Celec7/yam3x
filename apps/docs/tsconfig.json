{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["vitepress/client"],
    "paths": {
      "@registry/*": ["../../registry/*"]
    }
  },
  "include": ["**/*.ts", "**/*.vue", "**/*.md"],
  "exclude": [".vitepress/cache", ".vitepress/dist"],
  "vueCompilerOptions": {
    "vitePressExtensions": [".md"]
  }
}
